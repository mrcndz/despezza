{
  "kind": "collectionType",
  "collectionName": "user_profiles",
  "info": {
    "singularName": "user-profile",
    "pluralName": "user-profiles",
    "displayName": "User Profile",
    "description": "Extended user profile information"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "transactions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::transaction.transaction",
      "mappedBy": "owner"
    },
    "credit_cards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::credit-card.credit-card",
      "mappedBy": "owner"
    },
    "transaction_splits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::transaction-split.transaction-split",
      "mappedBy": "user"
    },
    "groups": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::group.group",
      "mappedBy": "users"
    }
  }
}
