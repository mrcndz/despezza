{
  "kind": "collectionType",
  "collectionName": "chats",
  "info": {
    "singularName": "chat",
    "pluralName": "chats",
    "displayName": "Chat",
    "description": "Group conversations"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text"
    },
    "chat_type": {
      "type": "enumeration",
      "enum": ["group", "direct"],
      "required": true
    },
    "group": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::group.group",
      "inversedBy": "chat"
    },
    "participants": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "inversedBy": "chats"
    },
    "messages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::message.message",
      "mappedBy": "chat"
    },
    "last_message_at": {
      "type": "datetime"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  }
}